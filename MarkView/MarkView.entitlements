<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox OFF — required for Process() to launch claude/codex CLI tools.
         Sandbox blocks execution of all external binaries regardless of entitlements. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Hardened runtime (release builds): voice dictation records the microphone, and
         "Open in Terminal.app" drives Terminal through Apple Events. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
