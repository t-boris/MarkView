      "api": "{\"method\":\"POST\",\"path\":\"/items\",\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"},{\"name\":\"Authorization\",\"value\":\"Bearer {{token}}\"}],\"body\":\"{}\",\"statuses\":[422],\"assertions\":[],\"captures\":[],\"timeoutSeconds\":20}",
