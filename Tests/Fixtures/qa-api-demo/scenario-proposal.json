  "nodes": [
    {
      "id": "root",
      "kind": "alternative",
      "title": "Choose branch",
      "detail": "Branch point. Each branch below is independent and logs in explicitly where it needs a token, because cookies and captured variables are reset between branches. Branches: (A) main flow login -> create -> read -> update -> read -> delete -> 404; (B) anonymous client expecting 401; (C) authenticated client sending invalid input expecting 422; (D) login with a wrong password expecting 401. Sources: openapi.json and server.py. The fixture instance is fresh and keeps state only in memory, so no baseline is needed.",
      "actor": "user",
      "app": "service",
      "api": "",
      "changesData": "no",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "a-login",
      "kind": "action",
      "title": "A: Log in with saved credentials",
      "detail": "POST /login with a JSON body built from the saved-login placeholders {{username}} and {{password}}. server.py accepts only the fixture user (alice) and its password, returns 200 with {\"token\": ...}, and sets a session cookie. The token is captured as a secret and used as a Bearer token in later steps. The response also echoes the password in a \"password\" field, so this step does not capture or assert that field.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"POST\",\"path\":\"/login\",\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"}],\"body\":\"{\\\"username\\\":{{username.json}},\\\"password\\\":{{password.json}}}\",\"statuses\":[200],\"assertions\":[],\"captures\":[{\"name\":\"token\",\"pointer\":\"/token\",\"secret\":true}],\"timeoutSeconds\":20}",
      "changesData": "unknown",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "a-create",
      "kind": "action",
      "title": "A: Create item",
      "detail": "POST /items with Bearer authentication and body {\"name\":\"QA item\"}. Per the contract and server.py, the response is 201 with {id: integer, name: string}. The id is captured as itemId for the rest of the CRUD flow on this actor.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"POST\",\"path\":\"/items\",\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"},{\"name\":\"Authorization\",\"value\":\"Bearer {{token}}\"}],\"body\":\"{\\\"name\\\":\\\"QA item\\\"}\",\"statuses\":[201],\"assertions\":[{\"pointer\":\"/name\",\"equals\":\"\\\"QA item\\\"\"}],\"captures\":[{\"name\":\"itemId\",\"pointer\":\"/id\",\"secret\":false}],\"timeoutSeconds\":20}",
      "changesData": "yes",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "a-read",
      "kind": "check",
      "title": "A: Read created item",
      "detail": "GET /items/{{itemId}} with Bearer authentication. Expects 200 and the same name that was created. This is a read-only check.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"GET\",\"path\":\"/items/{{itemId}}\",\"headers\":[{\"name\":\"Authorization\",\"value\":\"Bearer {{token}}\"}],\"body\":\"\",\"statuses\":[200],\"assertions\":[{\"pointer\":\"/name\",\"equals\":\"\\\"QA item\\\"\"}],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "no",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "a-update",
      "kind": "action",
      "title": "A: Update item name",
      "detail": "PATCH /items/{{itemId}} with Bearer authentication and body {\"name\":\"QA item renamed\"}. The contract says it replaces the name and returns the updated item (200). Note: server.py reads body['name'] without validation, so a PATCH without a name is outside the documented contract and is not tested here.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"PATCH\",\"path\":\"/items/{{itemId}}\",\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"},{\"name\":\"Authorization\",\"value\":\"Bearer {{token}}\"}],\"body\":\"{\\\"name\\\":\\\"QA item renamed\\\"}\",\"statuses\":[200],\"assertions\":[{\"pointer\":\"/name\",\"equals\":\"\\\"QA item renamed\\\"\"}],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "yes",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "a-read-updated",
      "kind": "check",
      "title": "A: Confirm the new name persisted",
      "detail": "GET /items/{{itemId}} again with Bearer authentication. Expects 200 and the updated name, which shows the PATCH was persisted and not only echoed in the response.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"GET\",\"path\":\"/items/{{itemId}}\",\"headers\":[{\"name\":\"Authorization\",\"value\":\"Bearer {{token}}\"}],\"body\":\"\",\"statuses\":[200],\"assertions\":[{\"pointer\":\"/name\",\"equals\":\"\\\"QA item renamed\\\"\"}],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "no",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "a-delete",
      "kind": "action",
      "title": "A: Delete item",
      "detail": "DELETE /items/{{itemId}} with Bearer authentication. The contract documents 204 with no response body. This also cleans up the data the flow created.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"DELETE\",\"path\":\"/items/{{itemId}}\",\"headers\":[{\"name\":\"Authorization\",\"value\":\"Bearer {{token}}\"}],\"body\":\"\",\"statuses\":[204],\"assertions\":[],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "yes",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "a-verify-404",
      "kind": "check",
      "title": "A: Deleted item returns 404",
      "detail": "GET /items/{{itemId}} with a valid Bearer token after deletion. Expects 404 with {\"error\":\"not found\"} (server.py). Authentication succeeds, so this 404 is about the missing item and not a permission problem.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"GET\",\"path\":\"/items/{{itemId}}\",\"headers\":[{\"name\":\"Authorization\",\"value\":\"Bearer {{token}}\"}],\"body\":\"\",\"statuses\":[404],\"assertions\":[{\"pointer\":\"/error\",\"equals\":\"\\\"not found\\\"\"}],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "no",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "b-anon-create",
      "kind": "action",
      "title": "B: Anonymous create item",
      "detail": "Anonymous client with no cookies or Authorization header sends POST /items with a valid body. The contract requires bearerAuth, and server.py rejects any request whose Authorization header is not the expected Bearer token with 401. The 401 is the documented expected result. The step is marked as possibly changing data only because it is a POST, and no item should be created.",
      "actor": "anon",
      "app": "service",
      "api": "{\"method\":\"POST\",\"path\":\"/items\",\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"}],\"body\":\"{\\\"name\\\":\\\"Anonymous item\\\"}\",\"statuses\":[401],\"assertions\":[],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "unknown",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "b-anon-check",
      "kind": "check",
      "title": "B: Create rejected with 401",
      "detail": "Asserts the previous anonymous response without sending a new request: status 401 and body {\"error\":\"unauthorized\"}.",
      "actor": "anon",
      "app": "service",
      "api": "{\"method\":\"GET\",\"path\":\"\",\"headers\":[],\"body\":\"\",\"statuses\":[401],\"assertions\":[{\"pointer\":\"/error\",\"equals\":\"\\\"unauthorized\\\"\"}],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "no",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "b-anon-read",
      "kind": "check",
      "title": "B: Anonymous read returns 401",
      "detail": "Anonymous GET /items/1 with no Authorization header. server.py checks the Bearer header before it looks up the item, so the expected result is 401 and not 404. This holds whether or not item 1 exists, so the step does not depend on data from other branches.",
      "actor": "anon",
      "app": "service",
      "api": "{\"method\":\"GET\",\"path\":\"/items/1\",\"headers\":[],\"body\":\"\",\"statuses\":[401],\"assertions\":[{\"pointer\":\"/error\",\"equals\":\"\\\"unauthorized\\\"\"}],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "no",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
      "conditionManual": false,
      "faultMode": "",
      "faultUrlPattern": "",
      "faultStatus": 0,
      "faultMilliseconds": 0
    },
    {
      "id": "c-login",
      "kind": "action",
      "title": "C: Log in with saved credentials",
      "detail": "Explicit login for the invalid-input branch, because variables from branch A are reset. POST /login with {{username}} and {{password}}, expecting 200, and the token is captured as a secret.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"POST\",\"path\":\"/login\",\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"}],\"body\":\"{\\\"username\\\":{{username.json}},\\\"password\\\":{{password.json}}}\",\"statuses\":[200],\"assertions\":[],\"captures\":[{\"name\":\"token\",\"pointer\":\"/token\",\"secret\":true}],\"timeoutSeconds\":20}",
      "changesData": "unknown",
      "conditionKind": "",
      "conditionEstablish": "",
      "conditionVerify": "",
