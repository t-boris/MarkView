    {
      "id": "d-login-bad",
      "kind": "action",
      "title": "D: Log in with wrong password",
      "detail": "POST /login with the saved username but a deliberately wrong literal password (not a secret). The contract and server.py return 401 for any credentials other than the fixture user's, so 401 is the documented expected result. No saved password is used or written in this step.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"POST\",\"path\":\"/login\",\"headers\":[{\"name\":\"Content-Type\",\"value\":\"application/json\"}],\"body\":\"{\\\"username\\\":{{username.json}},\\\"password\\\":\\\"wrong-password-qa\\\"}\",\"statuses\":[401],\"assertions\":[],\"captures\":[],\"timeoutSeconds\":20}",
      "changesData": "unknown",
