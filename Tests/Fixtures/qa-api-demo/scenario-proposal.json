    {
      "id": "d-session-check",
      "kind": "check",
      "title": "D: Failed login created no session",
      "detail": "GET /session with the same cookie jar after the failed login. A failed login sets no session cookie, so the contract and server.py give 401 with {\"signedIn\":false}.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"GET\",\"path\":\"/session\",\"headers\":[],\"body\":\"\",\"statuses\":[401],\"assertions\":[{\"pointer\":\"/signedIn\",\"equals\":\"false\"}],\"captures\":[],\"timeoutSeconds\":20}",
