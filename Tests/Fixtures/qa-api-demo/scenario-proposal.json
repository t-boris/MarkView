      "kind": "check",
      "title": "D: Wrong password rejected with 401",
      "detail": "Asserts the previous login response without sending a new request: status 401 and body {\"error\":\"invalid credentials\"}. There is no token in the response to capture.",
      "actor": "user",
      "app": "service",
      "api": "{\"method\":\"GET\",\"path\":\"\",\"headers\":[],\"body\":\"\",\"statuses\":[401],\"assertions\":[{\"pointer\":\"/error\",\"equals\":\"\\\"invalid credentials\\\"\"}],\"captures\":[],\"timeoutSeconds\":20}",
